# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Project Settings -> API
#
# A chave anon é pública por natureza: ela vai para o navegador de qualquer
# jeito. Quem protege os dados são as policies de RLS em supabase/schema.sql.
# Nunca coloque aqui a chave `service_role`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Project Settings -> API
#
# A chave anon é pública por natureza: ela vai para o navegador de qualquer
# jeito. Quem protege os dados são as policies de RLS em supabase/schema.sql.
# Nunca coloque aqui a chave `service_role`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Avisos do grupo com o app fechado (Web Push). Gere o par com:
#   npx web-push generate-vapid-keys
# A pública vai para o navegador; a privada fica só no servidor (Vercel) e
# nunca pode mudar depois de publicada, senão as inscrições antigas param.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que os serviços de push usam se algo der errado.
VAPID_SUBJECT=mailto:

# Senha que só a Vercel Cron conhece, para chamar /api/avisos/versiculo (o
# aviso diário do versículo) uma vez por dia. A MESMA senha precisa estar em
# `push_config.cron_segredo` no banco — veja supabase/schema-avisos-versiculo.sql.
CRON_SECRET=
